# Rendered by the nginx image's envsubst: ${BACKEND_URL} comes from the container
# environment; nginx's own $variables are left untouched.

# Keep https when TLS terminates in front of this proxy.
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $scheme;
}

server {
    listen 80;
    root /usr/share/nginx/html;

    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }

    # Vite puts a content hash in these file names.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location ~ ^/(api|auth)(/|$) {
        client_max_body_size 0;
        proxy_request_buffering off;
        proxy_pass ${BACKEND_URL};
        # odoo-sandbox routes on Host and compares it with Origin.
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_read_timeout 720s;
    }
}
